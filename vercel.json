{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server/src/index.js" },
    { "source": "/uploads/(.*)", "destination": "/server/src/index.js" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
